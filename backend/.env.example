# ──────────────────────────────────────────────────────────────────────────────
# VAYU-DRISHTI Backend — Environment Variable Template
#
# Copy this file to .env and fill in all required values before running locally.
# NEVER commit the .env file — it contains secrets.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your local values
#
# Required variables have no default and MUST be set.
# Optional variables show their default value.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=VAYU-DRISHTI
APP_VERSION=0.1.0
APP_DESCRIPTION=Air quality monitoring and geospatial analytics platform.

# Deployment environment. Accepted: development | staging | production
ENVIRONMENT=development

# Set to true only in local development. MUST be false in production.
DEBUG=true

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Number of uvicorn worker processes. For development, 1 is sufficient.
# In production, set to (2 * CPU_CORES) + 1.
WORKERS=1

# ── Security ───────────────────────────────────────────────────────────────────
# REQUIRED — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 characters. Rotate periodically in production.
SECRET_KEY=

# Comma-separated list of allowed CORS origins.
# In production, restrict to your frontend domain only.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── PostgreSQL Database ────────────────────────────────────────────────────────
# Host where PostgreSQL is running. Use 'db' when running with docker-compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vayu
# REQUIRED — Password for the database user.
POSTGRES_PASSWORD=
POSTGRES_DB=vayu_drishti

# ── Logging ────────────────────────────────────────────────────────────────────
# Log level. Accepted: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log output format. Use 'console' for human-readable local development.
# Use 'json' in staging/production for log aggregators (Datadog, Loki, CloudWatch).
LOG_FORMAT=console

# ── API ────────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ── Startup ────────────────────────────────────────────────────────────────────
# Set to 'true' to run 'alembic upgrade head' automatically before the API server
# starts. Useful for single-container deployments and docker compose environments.
# For production Kubernetes, use a dedicated init-container instead.
RUN_MIGRATIONS=false

# ── Team data / model outputs (optional) ──────────────────────────────────────
# Per domain: explicit path below (invalid → API fails at startup) → team
# output auto-discovered at its documented repo location → bundled, clearly
# labelled placeholder fixture → unavailable. GET /api/v1/sources shows the result.
# Station dataset: analysis_ready_dataset.csv (v1) or analysis_ready_dataset_v2.csv.
DATASET_PATH=
# HCHO hotspot clusters: cluster_summary.json from the hotspot pipeline.
HCHO_HOTSPOTS_PATH=
# Fire detections (JSON contract in backend/app/data/fires.py). No team source yet.
FIRE_EVENTS_PATH=
# Look for <repo>/analysis_ready_dataset.csv (then
# data_collection_pipeline/processed_data/analysis_ready_dataset_v2.csv),
# <repo>/reports/cluster_summary.json and, with ENABLE_ML_ENDPOINTS, a LightGBM
# artefact in <repo>/. Team data is validated at the adapter; its limitations
# (e.g. approximate coordinates) are listed in GET /api/v1/sources.
AUTO_DISCOVER_TEAM_OUTPUTS=true
# Use the bundled placeholder fixtures when no team output is found.
ENABLE_PLACEHOLDER_DATA=true
# Trust / promotion (backend/app/data/trust.py). Team outputs that pass the
# contract but not every promotion check are used as UNVERIFIED for their safe
# capabilities; true → only PROMOTED team outputs are used.
REQUIRE_TRUSTED_TEAM_DATA=false
# Opt-in isolated load probe for the model artefact (unpickles it in a
# subprocess, optionally with the training environment's interpreter).
# Without it a model can never be promoted.
MODEL_LOAD_CHECK=false
MODEL_PROBE_PYTHON=
# Directory holding lightgbm_model.joblib + lightgbm_*.json metadata.
# Served only when ENABLE_ML_ENDPOINTS=true AND the model trust gate promotes it
# (complete training metadata incl. model_type, task, feature_names, trained_at,
# temporal split_strategy, versions and input_example, no leaky features, plus
# the MODEL_LOAD_CHECK probe); otherwise it is withheld as "not validated".
ML_MODEL_PATH=
ENABLE_ML_ENDPOINTS=false
